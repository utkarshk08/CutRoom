# Keep the real key in .env.local. Never expose it through NEXT_PUBLIC_*.
OPENAI_API_KEY=replace_with_your_openai_api_key

# Optional. This is the cost-efficient default used by the layout endpoint.
OPENAI_LAYOUT_MODEL=gpt-5.6-luna

# Optional. Omit this to let Cutout Studio reuse OPENAI_LAYOUT_MODEL.
OPENAI_CUTOUT_MODEL=gpt-5.6-luna

# Private beta: set non-secret hosted values in wrangler.private-beta.jsonc.
# Local development on localhost works without an Access login.
# AI_ENABLED=false pauses AI. Hosted AI requires true plus all Access settings.
# APP_ORIGIN=https://cutroom-private-beta.<your-subdomain>.workers.dev
# CF_ACCESS_TEAM_DOMAIN=https://<your-team>.cloudflareaccess.com
# CF_ACCESS_AUD=<the Access application's audience tag>
# Store the hosted OPENAI_API_KEY as a Worker secret, never in Wrangler vars.
