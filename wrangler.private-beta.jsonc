{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cutroom-private-beta",
  "account_id": "49a801594716071baa92655b491f7e70",
  "main": "./worker.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  // Stable beta URL is protected by Access; never enable unprotected preview URLs.
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [{ "name": "AI_USAGE_LIMITER", "class_name": "AiUsageLimiter" }]
  },
  "migrations": [{ "tag": "v1-ai-usage", "new_sqlite_classes": ["AiUsageLimiter"] }],
  "vars": {
    "AI_ENABLED": "true",
    "APP_ORIGIN": "https://cutroom-private-beta.utkarshk0804.workers.dev",
    "CF_ACCESS_TEAM_DOMAIN": "https://purple-hill-caea.cloudflareaccess.com",
    "CF_ACCESS_AUD": "5f38b02df029ddcaffef3fb183c6fb4c4fe5136dddb21517b86ea25687808a3a"
  }
}
